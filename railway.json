{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK", "buildCommand": "pip install -r requirements.txt" },
  "deploy": {
    "startCommand": "gunicorn cebadata.wsgi:application --preload --workers 1 --bind 0.0.0.0:$PORT",
    "healthcheckPath": "/api/salud",
    "restartPolicyType": "ON_FAILURE"
  }
}
